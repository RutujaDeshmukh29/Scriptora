# Copy this file to .env and fill in real values. Never commit .env itself.

# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Local example: postgresql://postgres:postgres@127.0.0.1:5432/scriptora_dev
# Neon example:  postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/scriptora_dev

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
